# ───────────────────────── 应用 ─────────────────────────
APP_NAME=videomind
ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-please-use-32-byte

# ───────────────────────── PostgreSQL ─────────────────────────
POSTGRES_USER=videomind
POSTGRES_PASSWORD=videomind
POSTGRES_DB=videomind
DATABASE_URL=postgresql+asyncpg://videomind:videomind@localhost:15432/videomind

# ───────────────────────── Redis ─────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ───────────────────────── Qdrant ─────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=videomind_chunks

# ───────────────────────── MinIO ─────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videomind
MINIO_SECURE=false

# ───────────────────────── 推理双路径（API / 本地）─────────────────────────
# provider 取值：local | api     —— 同一份接口，env 切后端
# 主力走 api（Groq whisper-large-v3-turbo），本地 small/cpu 作无网兜底。
# 走本地需 ASR_PROVIDER=local；要走 GPU(turbo)须先装 CUDA toolkit12 + cuBLAS + cuDNN
ASR_PROVIDER=local        # local=faster-whisper，api=Groq openai 兼容 transcription
OCR_PROVIDER=local        # local=paddleocr(需 py≤3.13 + extras ocr)，api=ocr.space 远程
EMBEDDING_PROVIDER=local  # local=sentence-transformers，api=ollama/openai

# ── 本地路径配置（provider=local 时的档）──
# small cpu int8：零额外配置可用、多语言 99 语、质量跨数量级超 tiny
# 想要 top 质量：补 CUDA 库→改 ASR_MODEL=large-v3-turbo + ASR_DEVICE=cuda + int8_float16
ASR_MODEL=small           # tiny/base/small/medium/large-v3/large-v3-turbo
ASR_DEVICE=cpu            # auto/cuda/cpu —— 无 CUDA 库时用 cpu
ASR_COMPUTE_TYPE=int8     # int8/int8_float16/float16 —— CPU=int8 / GPU=int8_float16
# ASR 热词：留空=多语言自动检测中立；填领域词串提升专有名词召回
# 注意：本行不能写成 "ASR_INITIAL_PROMPT=  # 注释" —— dotenv 会把空值后的 #注释当字面值
ASR_INITIAL_PROMPT=

OCR_USE_GPU=false
OCR_LANG=ch

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto      # auto/cuda/cpu
EMBEDDING_DIM=1024

# ── API 路径配置（ASR_PROVIDER=api 时生效）──
# Groq OpenAI 兼容：https://api.groq.com/openai/v1  key 去 console.groq.com/keys 申请
# 注意：留空时本行不能写行尾注释（dotenv 会把注释当字面值），改写上面独立 # 行
ASR_API_BASE_URL=
ASR_API_KEY=
ASR_API_MODEL=whisper-large-v3-turbo
# Groq 免费档单请求硬限 25MB：音频超 20MB 直接走本地转写，不浪费注定失败的 API 调用
ASR_API_MAX_AUDIO_MB=20.0
# API 失败时运行时降级本地 faster-whisper 兜底（"API 主力+本地兜底"承诺的兑现开关）
ASR_FALLBACK_LOCAL=true

# ── ASR 加标点后处理（方案 2，opt-in）──
# Whisper 系列在中文不产标点 → 用轻量 LLM 给 full_text 补标点恢复可读性。
# 默认关（ASR_PUNCTUATE=false）：opt-in，不破坏现状；改字/异常自动回退裸原文。
# 实测 OpenRouter inclusionai/ling-3.0-flash:free 6.83s、防改字通过、无限流。
# 注意：免费档多为 reasoning 模型，max_tokens 须给足（思考吃 token，实测需 ≥4096，默认 8192）。
# dotenv 空值陷阱：base/key 留空时本行不能写行尾 # 注释（否则当字面值），注释单列一行
ASR_PUNCTUATE=false
ASR_PUNCTUATE_BASE_URL=
ASR_PUNCTUATE_API_KEY=
ASR_PUNCTUATE_MODEL=deepseek/deepseek-chat
ASR_PUNCTUATE_MAX_TOKENS=8192
ASR_PUNCTUATE_TEMPERATURE=0.1

# ── API 路径配置（OCR_PROVIDER=api 时生效）── ocr.space 免费 OCR
# endpoint 内部拼 /parse/image；key 去 https://ocr.space/ocrapi 免费注册
# OCREngine：1=最快 / 2=balanced+auto-detect(默认) / 3=最高精度200+语配额低
# OCR_API_LANGUAGE：三字母码，engine2/3 支持 auto(自动语种)；手动 chs/eng/jpn
OCR_API_BASE_URL=https://api.ocr.space
OCR_API_KEY=
OCR_API_ENGINE=2
OCR_API_LANGUAGE=auto
OCR_TIMEOUT_S=60.0

# ── API 路径配置（EMBEDDING_PROVIDER=api 时生效）──
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=

# ── Cross-encoder 重排（P2-1，opt-in，默认关）──
# RERANK_PROVIDER：off=固定权重 DeterministicReranker（不破坏现状）；
#   api=OpenRouter 远程 cross-encoder /api/v1/rerank（query+documents→relevance_score）；
#   local=本地 BGE-reranker-v2-m3（与 BGE-M3 embedder 同源、离线零成本、CJK 友好）。
# api/local 缺配置/缺依赖/加载失败时工厂自动降级 DeterministicReranker 兜底。
# 纯文本 RAG：documents 一律 {"text"}，不碰 Nemotron-rerank-vl 的 image 渠道。
# dotenv 空值陷阱：key 留空时不能写行尾 # 注释，否则当字面值；注释单列一行
RERANK_PROVIDER=off
RERANK_API_BASE_URL=https://openrouter.ai/api/v1
RERANK_API_KEY=
RERANK_API_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3
RERANK_LOCAL_DEVICE=cpu
# D-α：宽召回 60 后 api rerank top_n 须跟随到 60，否则 gold 被 cross-encoder top-20 截掉
RERANK_TOP_N=60
RERANK_TIMEOUT_S=30.0

# ── RAG 语义缓存（1.2，高频问答缓存，避免重复烧 LLM API）──
# 两级：L1 规范化(query+media_ids) SHA256 精确匹配（零嵌入成本）；
#       L2 embedding 余弦 ≥ 阈值（同媒体集内才算命中——media_ids 一致是硬约束）。
# 存 Redis DB0 JSON + ZSET LRU 索引；TTL 到期自动失效，索引重建/删媒体主动失效。
# fail-open：Redis/嵌入故障时跳过缓存直走原流程，缓存绝不阻断问答。
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_TTL_S=21600       # 6h
SEMANTIC_CACHE_THRESHOLD=0.92    # 余弦阈值：过高≈永远 miss；过低≈答非所问
SEMANTIC_CACHE_MAX_ENTRIES=256   # 单媒体集条目上限（LRU 逐出）

# ── 视频处理 ──
VIDEO_SEGMENT_WINDOW_MS=60000   # 60s 窗口
VIDEO_CHUNK_OVERLAP_MS=1000
FFMPEG_PATH=ffmpeg
# 子进程超时兜底：损坏文件可让 ffmpeg 永不返回挂死 worker（转码 15 分钟 / probe 1 分钟）
FFMPEG_TIMEOUT_S=900.0
FFPROBE_TIMEOUT_S=60.0

# ── 上传（1.5 流式写盘）──
# 超过上限在收包途中即断 413；上传全程分块落盘，API 进程内存占用恒定
UPLOAD_MAX_MB=500.0

# ── 任务编排 ──
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
GPU_LOCK_TTL=30                 # GPU 锁心跳续租秒数

# ── 下载 ──
DOWNLOAD_DIR=./_downloads
YTDLP_PROXY=
# yt-dlp 网络兜底（防慢源挂死 worker）：socket 超时 / HTTP+分片自愈重试
DOWNLOAD_SOCKET_TIMEOUT_S=30.0
DOWNLOAD_RETRIES=3
# 磁盘预检：下载前剩余空间低于此值直接等盘释放（RetryableError）
DOWNLOAD_MIN_FREE_GB=2.0

# ───────────────────────── OpenTelemetry ─────────────────────────
# OTel Collector / Jaeger / Zipkin endpoint (默认本地 4317 gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=videomind
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
