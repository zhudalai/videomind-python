# ───────────────────────── 应用 ─────────────────────────
APP_NAME=videomind
ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-please-use-32-byte

# ───────────────────────── PostgreSQL ─────────────────────────
POSTGRES_USER=videomind
POSTGRES_PASSWORD=videomind
POSTGRES_DB=videomind
DATABASE_URL=postgresql+asyncpg://videomind:videomind@localhost:15432/videomind

# ───────────────────────── Redis ─────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ───────────────────────── Qdrant ─────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=videomind_chunks

# ───────────────────────── MinIO ─────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videomind
MINIO_SECURE=false

# ───────────────────────── 推理双路径（API / 本地）─────────────────────────
# provider 取值：local | api     —— 同一份接口，env 切后端
# 主力走 api（Groq whisper-large-v3-turbo），本地 small/cpu 作无网兜底。
# 走本地需 ASR_PROVIDER=local；要走 GPU(turbo)须先装 CUDA toolkit12 + cuBLAS + cuDNN
ASR_PROVIDER=local        # local=faster-whisper，api=Groq openai 兼容 transcription
OCR_PROVIDER=local        # local=paddleocr，api=外部 OCR 服务
EMBEDDING_PROVIDER=local  # local=sentence-transformers，api=ollama/openai

# ── 本地路径配置（provider=local 时的档）──
# small cpu int8：零额外配置可用、多语言 99 语、质量跨数量级超 tiny
# 想要 top 质量：补 CUDA 库→改 ASR_MODEL=large-v3-turbo + ASR_DEVICE=cuda + int8_float16
ASR_MODEL=small           # tiny/base/small/medium/large-v3/large-v3-turbo
ASR_DEVICE=cpu            # auto/cuda/cpu —— 无 CUDA 库时用 cpu
ASR_COMPUTE_TYPE=int8     # int8/int8_float16/float16 —— CPU=int8 / GPU=int8_float16
# ASR 热词：留空=多语言自动检测中立；填领域词串提升专有名词召回
# 注意：本行不能写成 "ASR_INITIAL_PROMPT=  # 注释" —— dotenv 会把空值后的 #注释当字面值
ASR_INITIAL_PROMPT=

OCR_USE_GPU=false
OCR_LANG=ch

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto      # auto/cuda/cpu
EMBEDDING_DIM=1024

# ── API 路径配置（ASR_PROVIDER=api 时生效）──
# Groq OpenAI 兼容：https://api.groq.com/openai/v1  key 去 console.groq.com/keys 申请
# 注意：留空时本行不能写行尾注释（dotenv 会把注释当字面值），改写上面独立 # 行
ASR_API_BASE_URL=
ASR_API_KEY=
ASR_API_MODEL=whisper-large-v3-turbo

# ── ASR 加标点后处理（方案 2，opt-in）──
# Whisper 系列在中文不产标点 → 用轻量 LLM 给 full_text 补标点恢复可读性。
# 默认关（ASR_PUNCTUATE=false）：opt-in，不破坏现状；改字/异常自动回退裸原文。
# 实测 OpenRouter inclusionai/ling-3.0-flash:free 6.83s、防改字通过、无限流。
# 注意：免费档多为 reasoning 模型，max_tokens 须给足（思考吃 token，实测需 ≥4096，默认 8192）。
# dotenv 空值陷阱：base/key 留空时本行不能写行尾 # 注释（否则当字面值），注释单列一行
ASR_PUNCTUATE=false
ASR_PUNCTUATE_BASE_URL=
ASR_PUNCTUATE_API_KEY=
ASR_PUNCTUATE_MODEL=deepseek/deepseek-chat
ASR_PUNCTUATE_MAX_TOKENS=8192
ASR_PUNCTUATE_TEMPERATURE=0.1

# ── API 路径配置（OCR_PROVIDER=api 时生效）──
OCR_API_BASE_URL=
OCR_API_KEY=

# ── API 路径配置（EMBEDDING_PROVIDER=api 时生效）──
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=

# ── 视频处理 ──
VIDEO_SEGMENT_WINDOW_MS=60000   # 60s 窗口
VIDEO_CHUNK_OVERLAP_MS=1000
FFMPEG_PATH=ffmpeg

# ── 任务编排 ──
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
GPU_LOCK_TTL=30                 # GPU 锁心跳续租秒数

# ── 下载 ──
DOWNLOAD_DIR=./_downloads
YTDLP_PROXY=

# ───────────────────────── OpenTelemetry ─────────────────────────
# OTel Collector / Jaeger / Zipkin endpoint (默认本地 4317 gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=videomind
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
