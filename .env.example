# ───────────────────────── 应用 ─────────────────────────
APP_NAME=videomind
ENV=dev
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-please-use-32-byte

# ───────────────────────── PostgreSQL ─────────────────────────
POSTGRES_USER=videomind
POSTGRES_PASSWORD=videomind
POSTGRES_DB=videomind
DATABASE_URL=postgresql+asyncpg://videomind:videomind@localhost:15432/videomind

# ───────────────────────── Redis ─────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ───────────────────────── Qdrant ─────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=videomind_chunks

# ───────────────────────── MinIO ─────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videomind
MINIO_SECURE=false

# ───────────────────────── 推理双路径（API / 本地）─────────────────────────
# provider 取值：local | api     —— 同一份接口，env 切后端
ASR_PROVIDER=local        # local=faster-whisper，api=openai whisper
OCR_PROVIDER=local        # local=paddleocr，api=外部 OCR 服务
EMBEDDING_PROVIDER=local  # local=sentence-transformers，api=ollama/openai

# ── 本地路径配置 ──
ASR_MODEL=tiny            # tiny/base/small/medium/large-v3
ASR_DEVICE=auto           # auto/cuda/cpu
ASR_COMPUTE_TYPE=int8     # int8/int8_float16/float16

OCR_USE_GPU=false
OCR_LANG=ch

EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto      # auto/cuda/cpu
EMBEDDING_DIM=1024

# ── API 路径配置（ASR_PROVIDER=api 时生效）──
ASR_API_BASE_URL=
ASR_API_KEY=

# ── API 路径配置（OCR_PROVIDER=api 时生效）──
OCR_API_BASE_URL=
OCR_API_KEY=

# ── API 路径配置（EMBEDDING_PROVIDER=api 时生效）──
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=

# ── 视频处理 ──
VIDEO_SEGMENT_WINDOW_MS=60000   # 60s 窗口
VIDEO_CHUNK_OVERLAP_MS=1000
FFMPEG_PATH=ffmpeg

# ── 任务编排 ──
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
GPU_LOCK_TTL=30                 # GPU 锁心跳续租秒数

# ── 下载 ──
DOWNLOAD_DIR=./_downloads
YTDLP_PROXY=

# ───────────────────────── OpenTelemetry ─────────────────────────
# OTel Collector / Jaeger / Zipkin endpoint (默认本地 4317 gRPC)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=videomind
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev
